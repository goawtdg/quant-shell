# 复制本文件为 .env 并填入真实值。
#   copy .env.example .env
# .env 已在 .gitignore 中，切勿提交。
# 未列出的项见 src/quant_shell/config/settings.py 默认值。

# ── 标的与定时监控 ──
DEFAULT_SYMBOL=510300
MONITOR_SYMBOLS=510300,510500
MONITOR_INTERVAL_MIN=60

# ── DeepSeek（可选；留空则跳过 LLM，走规则/OSINT）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SEC=90
DEEPSEEK_ENABLED=true

# ── L5 风控阈值 ──
MAX_DRAWDOWN=0.15
PORTFOLIO_MAX_DRAWDOWN=0.15
SINGLE_STOCK_LIMIT=0.10
TOTAL_POSITION_LIMIT=0.80
KELLY_CAP=0.30
RISK_FREE_RATE=0.03

# ── 模拟盘（纸面，非实盘）──
# PAPER_INITIAL_CASH=1000000
# PAPER_COMMISSION_RATE=0.0003
# PAPER_AUTO_APPROVE=true

# ── 网络代理（可选）──
# 设 true 后本进程直连，不改系统/用户代理环境变量
DISABLE_PROXY=false
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ── 选股 / 联动 ──
# PICK_UNIVERSE=csi300
PICK_MAX_SYMBOLS=0
LINKAGE_SKIP_INDUSTRY_FETCH=false

# ── 信号开仓线 ──
SIGNAL_THRESHOLD_MODERATE=0.07
SIGNAL_THRESHOLD_STRONG=0.10
SIGNAL_MODERATE_BUY_SCALE=0.5
STRATEGY_DEGRADATION_THRESHOLD=-0.30
STRATEGY_DEGRADED_ENTRY_SCALE=0.5

# ── 插件（module:attr；装 reference 包后可省略，用其默认实现）──
# STRATEGY_MODULE=reference_policy.policy.plugin:ReferencePolicyPlugin
# PICKER_MODULE=reference_policy.picker.engine:FactorStrategyEngine
# COMMIT_MODULE=reference_policy.policy.commit:commit_decision
# FACTOR_MODULE=examples.user_factors.registry:build_registry
# SIGNAL_MODULE=
# INTEL_MODULE=
# STRATEGY_PROFILE=
# QUANT_SHELL_ROOT=
